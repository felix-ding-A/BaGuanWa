.container {
  background: linear-gradient(to bottom right, #F87171, #FBBF24);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-card {
  background: white;
  padding: 60rpx;
  border-radius: 40rpx;
  width: 80%;
  text-align: center;
  box-shadow: 0 20rpx 50rpx rgba(0,0,0,0.2);
}

.icon-wrap {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 60rpx;
  color: #333;
}

.password-input {
  background: #F3F4F6;
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.error-msg {
  color: #EF4444;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  height: 40rpx;
}

.btn-group {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.cancel-btn {
  flex: 1;
  background: #F3F4F6;
  color: #4B5563;
  border-radius: 40rpx;
}

.login-btn {
  flex: 1;
  background: linear-gradient(to right, #EF4444, #F59E0B);
  color: white;
  border-radius: 40rpx;
}