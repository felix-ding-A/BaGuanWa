<page-meta page-orientation="{{orientation}}"></page-meta>
<view class="container {{bgConfig && bgConfig.type === 'effect' ? 'effect-' + bgConfig.value : ''}} {{isSpinning ? 'is-spinning' : ''}} {{result ? 'is-celebrating' : ''}}" style="{{containerBgStyle}}">
  <!-- 自定义 9:16 背景图片（位于页面最底层） -->
  <block wx:if="{{bgConfig && bgConfig.type === 'image' && bgConfig.value}}">
    <image class="custom-bg-image" src="{{bgConfig.value}}" mode="aspectFill" />
    <view class="custom-bg-overlay"></view>
  </block>

  <!-- 动效 1: 极光流动 (Aurora) -->
  <view class="dynamic-aurora-wrap" wx:if="{{bgConfig && bgConfig.type === 'effect' && bgConfig.value === 'aurora'}}">
    <view class="aurora-light a1"></view>
    <view class="aurora-light a2"></view>
    <view class="aurora-light a3"></view>
  </view>

  <!-- 动效 2: 迪斯科闪屏 (Disco Strobe) -->
  <view class="dynamic-disco-wrap" wx:if="{{bgConfig && bgConfig.type === 'effect' && bgConfig.value === 'disco'}}">
    <view class="disco-strobe-layer"></view>
    <view class="disco-beam b1"></view>
    <view class="disco-beam b2"></view>
  </view>

  <!-- 动效 3: 星空流星雨 (Stars & Meteors) -->
  <view class="dynamic-stars-wrap" wx:if="{{bgConfig && bgConfig.type === 'effect' && bgConfig.value === 'stars'}}">
    <view class="stars-stars-layer"></view>
    <view class="shooting-star s1"></view>
    <view class="shooting-star s2"></view>
    <view class="shooting-star s3"></view>
  </view>

  <!-- 动效 4: 赛博霓虹网格 (Cyberpunk) -->
  <view class="dynamic-cyber-wrap" wx:if="{{bgConfig && bgConfig.type === 'effect' && bgConfig.value === 'cyber'}}">
    <view class="cyber-sun"></view>
    <view class="cyber-horizon"></view>
    <view class="cyber-grid"></view>
  </view>

  <!-- 动效 5: 舞台聚光特写 (Spotlight) -->
  <view class="dynamic-spotlight-wrap" wx:if="{{bgConfig && bgConfig.type === 'effect' && bgConfig.value === 'spotlight'}}">
    <view class="spotlight-beam"></view>
    <view class="spotlight-floor"></view>
  </view>

  <view class="help-btn" bindtap="goToRules">?</view>
  <view class="rotate-btn" bindtap="toggleOrientation">
    <image src="data:image/svg+xml,%3Csvg%20viewBox%3D%220%200%201024%201024%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20fill%3D%22%23ffffff%22%20d%3D%22M869.973713%20391.222061a51.174924%2051.174924%200%200%201%2051.174924%2051.174924V870.475227a51.174924%2051.174924%200%200%201-51.174924%2051.174924H442.151346a51.174924%2051.174924%200%200%201-51.174924-51.174924V442.396985a51.174924%2051.174924%200%200%201%2051.174924-51.174924H869.973713m0-102.349848H442.151346a153.524773%20153.524773%200%200%200-153.524773%20153.524772V870.475227a153.524773%20153.524773%200%200%200%20153.524773%20153.524773H869.973713a153.524773%20153.524773%200%200%200%20153.524773-153.524773V442.396985a153.524773%20153.524773%200%200%200-153.524773-153.524772zM0%20429.859129a49.895551%2049.895551%200%200%200%2099.535228%200c0-185.764975%2046.057432-245.383762%20190.114843-245.383762h35.822447a49.383802%2049.383802%200%200%200%200%2069.597897%2051.174924%2051.174924%200%200%200%2070.621396%200L470.553429%20179.613749a64.736279%2064.736279%200%200%200%200-91.603114L396.605663%2014.830493a49.639677%2049.639677%200%200%200-70.87727%2069.853772h-35.822447C89.556118%2084.684265%200%20191.128107%200%20429.859129z%22%2F%3E%3C%2Fsvg%3E" class="rotate-icon" />
  </view>
  
  <view class="title animate-bounce">🎉 幸运大转盘 🎉</view>

  <view class="wheel-container">
    <!-- 动效 6: 街机跑马灯灯珠环 (Marquee Bulbs) -->
    <view class="marquee-bulb-ring {{isSpinning ? 'spinning' : ''}} {{result ? 'celebrating' : ''}}" wx:if="{{bgConfig && bgConfig.type === 'effect' && bgConfig.value === 'marquee'}}">
      <view class="bulb bulb-{{index}}" wx:for="{{24}}" wx:key="*this" style="--angle: {{index * 15}}deg;"></view>
    </view>
    <view class="pointer"></view>
    <view class="wheel" animation="{{animationData}}">
      <canvas type="2d" id="wheelCanvas" style="width: 100%; height: 100%;"></canvas>
    </view>
  </view>

  <button class="spin-btn {{isSpinning ? 'disabled' : ''}}" bindtap="spinWheel" disabled="{{isSpinning}}">
    {{isSpinning ? '抽奖中...' : '开始抽奖'}}
  </button>

  <view class="result-modal" wx:if="{{result}}">
    <view class="result-content">
      <view class="result-title">🎊 恭喜获得</view>
      <view class="result-name">{{result}}</view>
      <button class="close-btn" bindtap="closeResult">确定</button>
    </view>
  </view>
</view>