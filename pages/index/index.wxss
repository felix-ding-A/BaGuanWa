.container {
  background: linear-gradient(to bottom right, #C084FC, #F472B6, #FB7185);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.help-btn {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(8px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 40rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  z-index: 100;
}

.rotate-btn {
  position: absolute;
  top: 40rpx;
  right: 140rpx;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(8px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 40rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  z-index: 100;
}

.rotate-icon {
  width: 55%;
  height: 55%;
}

.title {
  font-size: 60rpx;
  color: white;
  margin-bottom: 60rpx;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.2);
  font-weight: bold;
}

.animate-bounce {
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(-25%); animation-timing-function: cubic-bezier(0.8, 0, 1, 1); }
  50% { transform: translateY(0); animation-timing-function: cubic-bezier(0, 0, 0.2, 1); }
}

.wheel-container {
  position: relative;
  margin-bottom: 80rpx;
  width: 300px;
  height: 300px;
}

.pointer {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 40rpx solid transparent;
  border-right: 40rpx solid transparent;
  border-top: 80rpx solid #FBBF24;
  z-index: 10;
  filter: drop-shadow(0 4rpx 6rpx rgba(0,0,0,0.3));
}

.wheel {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  box-shadow: 0 20rpx 50rpx rgba(0,0,0,0.3);
  overflow: hidden;
  background: white;
}

.spin-btn {
  background: linear-gradient(to right, #FBBF24, #F97316);
  color: white;
  padding: 0 80rpx;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 30rpx rgba(249, 115, 22, 0.4);
  transition: all 0.2s;
  border: none;
}

.spin-btn::after {
  border: none;
}

.spin-btn.disabled {
  opacity: 0.5;
  transform: none;
  background: #ccc;
  box-shadow: none;
}

.result-modal {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  animation: fadeIn 0.3s ease-out;
}

.result-content {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 60rpx;
  border-radius: 30rpx;
  text-align: center;
  box-shadow: 0 20rpx 50rpx rgba(0,0,0,0.2);
  transform: scale(0.9);
  animation: popIn 0.3s ease-out forwards;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes popIn {
  to { transform: scale(1); }
}

.result-title {
  font-size: 40rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.result-name {
  font-size: 60rpx;
  color: #F97316;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.close-btn {
  background: #F97316;
  color: white;
  border-radius: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 32rpx;
}

@media (orientation: landscape) {
  .help-btn, .rotate-btn {
    top: 10px;
    width: 30px;
    height: 30px;
    font-size: 16px;
  }
  .help-btn {
    right: 15px;
  }
  .rotate-btn {
    right: 55px;
  }
  .title {
    font-size: 20px;
    margin-bottom: 10px;
    margin-top: 15px;
  }
  .wheel-container {
    width: 220px;
    height: 220px;
    margin-bottom: 15px;
  }
  .pointer {
    top: -15px;
    border-left: 15px solid transparent;
    border-right: 15px solid transparent;
    border-top: 30px solid #FBBF24;
  }
  .spin-btn {
    height: 40px;
    line-height: 40px;
    font-size: 16px;
    padding: 0 40px;
  }
  .result-content {
    padding: 20px;
  }
  .result-title {
    font-size: 16px;
    margin-bottom: 10px;
  }
  .result-name {
    font-size: 24px;
    margin-bottom: 20px;
  }
  .close-btn {
    height: 30px;
    line-height: 30px;
    font-size: 14px;
    border-radius: 15px;
  }
}