.container {
  background: linear-gradient(to bottom right, #34D399, #3B82F6);
  min-height: 100vh;
  padding: 40rpx 0;
}

.admin-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-radius: 40rpx;
  margin: 0 40rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 50rpx rgba(0,0,0,0.2);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
}

.logout-btn {
  font-size: 24rpx;
  margin: 0;
  padding: 10rpx 20rpx;
  background: #F3F4F6;
  color: #4B5563;
  border-radius: 20rpx;
}

.section {
  margin-bottom: 60rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #374151;
  border-bottom: 2rpx solid #E5E7EB;
  padding-bottom: 10rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.duration-input {
  background: #F3F4F6;
  padding: 0 20rpx;
  border-radius: 10rpx;
  width: 200rpx;
  text-align: right;
  height: 80rpx;
  font-size: 32rpx;
}

.intervention {
  margin-top: 30rpx;
  padding: 20rpx;
  background: #FEF3C7;
  border-radius: 20rpx;
}

.picker {
  color: #D97706;
  font-weight: bold;
}

.total-prob {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.total-prob.success {
  color: #10B981;
}

.total-prob.error {
  color: #EF4444;
}

.prize-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 10rpx;
}

.prize-name {
  flex: 2;
  min-width: 0;
  background: #F3F4F6;
  padding: 0 20rpx;
  border-radius: 10rpx;
  height: 80rpx;
  font-size: 32rpx;
}

.prize-prob {
  flex: 1;
  min-width: 0;
  background: #F3F4F6;
  padding: 0 20rpx;
  border-radius: 10rpx;
  text-align: center;
  height: 80rpx;
  font-size: 32rpx;
}

.percent-sign {
  font-size: 32rpx;
  color: #374151;
  width: 40rpx;
  text-align: center;
}

.color-preview {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 4rpx solid white;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
}

.delete-btn {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  background: #FEE2E2;
  color: #EF4444;
  border-radius: 50%;
  font-weight: bold;
  font-size: 40rpx;
}

.action-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.action-buttons button {
  flex: 1 1 calc(50% - 10rpx);
  margin: 0;
  font-size: 28rpx;
}

.add-btn {
  background: #ECFDF5;
  color: #10B981;
  border-radius: 20rpx;
}

.random-btn {
  background: #FEF2F2;
  color: #EF4444;
  border-radius: 20rpx;
}

.avg-btn {
  background: #EFF6FF;
  color: #3B82F6;
  border-radius: 20rpx;
}

.color-btn {
  background: #FDF4FF;
  color: #D946EF;
  border-radius: 20rpx;
}

.save-btn {
  background: linear-gradient(to right, #10B981, #3B82F6);
  color: white;
  border-radius: 20rpx;
  font-weight: bold;
}