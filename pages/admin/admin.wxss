.container {
  background: linear-gradient(to bottom right, #34D399, #3B82F6);
  min-height: 100vh;
  padding: 40rpx 0;
}

.admin-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-radius: 40rpx;
  margin: 0 40rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 50rpx rgba(0,0,0,0.2);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
}

.logout-btn {
  font-size: 24rpx;
  margin: 0;
  padding: 10rpx 24rpx;
  background: #F3F4F6;
  color: #64748B;
  border-radius: 20rpx;
  font-weight: 500;
  line-height: 1.4;
  flex-shrink: 0;
}

.logout-btn:active {
  background: #E2E8F0;
}

/* 顶部修改背景入口卡片 */
.top-bg-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #EEF2FF, #F5F3FF);
  border: 2rpx solid #E0E7FF;
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 14rpx rgba(99, 102, 241, 0.08);
  transition: all 0.2s;
  cursor: pointer;
}

.entry-hover {
  opacity: 0.88;
  transform: scale(0.99);
}

.entry-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  flex: 1;
}

.entry-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  box-shadow: 0 4rpx 10rpx rgba(99, 102, 241, 0.25);
  flex-shrink: 0;
}

.entry-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.entry-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1E1B4B;
}

.entry-desc {
  font-size: 22rpx;
  color: #6B7280;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.entry-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #FFFFFF;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  border: 1rpx solid #E0E7FF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.entry-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #4F46E5;
}

.entry-arrow {
  font-size: 26rpx;
  color: #818CF8;
  line-height: 1;
}

.section {
  margin-bottom: 60rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #374151;
  border-bottom: 2rpx solid #E5E7EB;
  padding-bottom: 10rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.duration-input {
  background: #F3F4F6;
  padding: 0 20rpx;
  border-radius: 10rpx;
  width: 200rpx;
  text-align: right;
  height: 80rpx;
  font-size: 32rpx;
}

.intervention {
  margin-top: 30rpx;
  padding: 20rpx;
  background: #FEF3C7;
  border-radius: 20rpx;
}

.picker {
  color: #D97706;
  font-weight: bold;
}

.total-prob {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.total-prob.success {
  color: #10B981;
}

.total-prob.error {
  color: #EF4444;
}

.prize-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 10rpx;
}

.prize-name {
  flex: 2;
  min-width: 0;
  background: #F3F4F6;
  padding: 0 20rpx;
  border-radius: 10rpx;
  height: 80rpx;
  font-size: 32rpx;
}

.prize-prob {
  flex: 1;
  min-width: 0;
  background: #F3F4F6;
  padding: 0 20rpx;
  border-radius: 10rpx;
  text-align: center;
  height: 80rpx;
  font-size: 32rpx;
}

.percent-sign {
  font-size: 32rpx;
  color: #374151;
  width: 40rpx;
  text-align: center;
}

.color-preview {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 4rpx solid white;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
}

.delete-btn {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  background: #FEE2E2;
  color: #EF4444;
  border-radius: 50%;
  font-weight: bold;
  font-size: 40rpx;
}

.action-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.action-buttons button {
  flex: 1 1 calc(50% - 10rpx);
  margin: 0;
  font-size: 28rpx;
}

.add-btn {
  background: #ECFDF5;
  color: #10B981;
  border-radius: 20rpx;
}

.random-btn {
  background: #FEF2F2;
  color: #EF4444;
  border-radius: 20rpx;
}

.avg-btn {
  background: #EFF6FF;
  color: #3B82F6;
  border-radius: 20rpx;
}

.color-btn {
  background: #FDF4FF;
  color: #D946EF;
  border-radius: 20rpx;
}

.save-btn {
  background: linear-gradient(to right, #10B981, #3B82F6);
  color: white;
  border-radius: 20rpx;
  font-weight: bold;
}

/* ===== 修改背景弹窗与调色板 ===== */
.bg-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(8px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease-out;
}

.bg-modal-card {
  width: 660rpx;
  max-height: 88vh;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.25);
  overflow-y: auto;
  animation: popIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes popIn {
  from { transform: scale(0.92); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.bg-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bg-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #0F172A;
}

.bg-modal-close {
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 32rpx;
  color: #94A3B8;
  border-radius: 50%;
  background: #F1F5F9;
}

.bg-modal-subtitle {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

/* 实时 9:16 手机预览框 */
.preview-container {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #F8FAFC;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E2E8F0;
}

.preview-phone {
  width: 140rpx;
  height: 248rpx; /* 约 9:16 */
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  border: 4rpx solid #334155;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}

.phone-bg {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

.default-gradient {
  background: linear-gradient(to bottom right, #C084FC, #F472B6, #FB7185);
}

.phone-bg-img {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

.phone-wheel-mock {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.1);
}

.mock-pointer {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 14rpx solid #FBBF24;
  margin-bottom: -4rpx;
  z-index: 3;
}

.mock-wheel {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: conic-gradient(
    #FF6B6B 0deg 60deg, 
    #4ECDC4 60deg 120deg, 
    #45B7D1 120deg 180deg, 
    #FFA07A 180deg 240deg, 
    #98D8C8 240deg 300deg, 
    #F7DC6F 300deg 360deg
  );
  border: 2rpx solid white;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.2);
  position: relative;
}

.mock-center {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: white;
  border: 2rpx solid #FFD700;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.mock-label {
  font-size: 14rpx;
  color: white;
  margin-top: 10rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.7);
  font-weight: bold;
}

.preview-desc {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.preview-tag {
  font-size: 22rpx;
  font-weight: bold;
  color: #6366F1;
}

.preview-state-text {
  font-size: 24rpx;
  color: #1E293B;
  font-weight: 600;
}

.preview-sub-tip {
  font-size: 20rpx;
  color: #64748B;
  line-height: 1.4;
}

/* Tab 切换栏 */
.bg-tabs {
  display: flex;
  background: #F1F5F9;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.bg-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  color: #64748B;
  font-weight: 500;
  border-radius: 14rpx;
  transition: all 0.2s;
}

.bg-tab.active {
  background: #FFFFFF;
  color: #6366F1;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* Tab 内容区域 */
.tab-body {
  margin-bottom: 24rpx;
}

/* 方式一：图片上传 */
.upload-area {
  border: 3rpx dashed #CBD5E1;
  border-radius: 20rpx;
  padding: 36rpx 20rpx;
  text-align: center;
  background: #F8FAFC;
  cursor: pointer;
  transition: all 0.2s;
}

.upload-area:active {
  background: #F1F5F9;
}

.upload-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.upload-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #334155;
  margin-bottom: 8rpx;
}

.upload-note {
  font-size: 22rpx;
  color: #10B981;
}

.image-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.clear-img-btn {
  font-size: 22rpx;
  color: #EF4444;
  padding: 6rpx 12rpx;
}

.tip-row {
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 16rpx;
  line-height: 1.4;
}

/* 方式二：调色板选色 */
.palette-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 14rpx;
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.color-block {
  height: 60rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
  position: relative;
  border: 2rpx solid transparent;
}

.color-block.selected {
  border: 4rpx solid #3B82F6;
  transform: scale(1.06);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.4);
}

.color-check {
  color: white;
  font-weight: bold;
  font-size: 26rpx;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.6);
}

.custom-color-section {
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #E2E8F0;
}

.hue-slider-box {
  border-radius: 20rpx;
  background: linear-gradient(
    to right, 
    #ff0000 0%, 
    #ffff00 17%, 
    #00ff00 33%, 
    #00ffff 50%, 
    #0000ff 67%, 
    #ff00ff 83%, 
    #ff0000 100%
  );
  padding: 0 8rpx;
  margin-bottom: 16rpx;
}

.hex-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hex-badge {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  border: 3rpx solid white;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.2);
  flex-shrink: 0;
}

.hex-input {
  flex: 1;
  background: white;
  border: 1rpx solid #CBD5E1;
  border-radius: 12rpx;
  height: 60rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #1E293B;
}

/* 弹窗底部操作按钮 */
.bg-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.modal-reset-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  background: #F1F5F9;
  color: #64748B;
  border-radius: 18rpx;
  border: none;
  font-weight: 500;
}

.modal-confirm-btn {
  flex: 2;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  background: linear-gradient(to right, #6366F1, #8B5CF6);
  color: white;
  border-radius: 18rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(99, 102, 241, 0.35);
}

/* 动效选项卡网格 */
.effect-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.effect-card {
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 20rpx;
  padding: 20rpx;
  position: relative;
  transition: all 0.2s;
  cursor: pointer;
  display: flex;
  flex-direction: column;
}

.effect-card.selected {
  background: #EEF2FF;
  border-color: #6366F1;
  box-shadow: 0 4rpx 14rpx rgba(99, 102, 241, 0.2);
}

.effect-icon-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.effect-icon {
  font-size: 36rpx;
}

.effect-tag {
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  background: rgba(99, 102, 241, 0.1);
  color: #4F46E5;
  font-weight: 600;
}

.effect-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #1E1B4B;
  margin-bottom: 6rpx;
}

.effect-desc {
  font-size: 20rpx;
  color: #64748B;
  line-height: 1.3;
}

.effect-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #6366F1;
  color: white;
  font-size: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 小手机预览框里的动效预览样式 */
.effect-preview-aurora {
  background: linear-gradient(125deg, #0ea5e9, #8b5cf6, #ec4899, #10b981);
  background-size: 300% 300%;
  animation: miniAurora 4s ease infinite;
}

@keyframes miniAurora {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.effect-preview-marquee {
  background: #111827;
}

.preview-mini-marquee {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 106rpx;
  height: 106rpx;
  border: 4rpx dashed #F59E0B;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  animation: miniSpin 3s linear infinite;
}

@keyframes miniSpin {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

.effect-preview-disco {
  animation: miniDisco 0.8s infinite alternate;
}

@keyframes miniDisco {
  0% { background: #831843; }
  50% { background: #1e3a8a; }
  100% { background: #701a75; }
}

.effect-preview-stars {
  background: #020617;
}

.preview-mini-stars {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: radial-gradient(2rpx 2rpx at 20rpx 30rpx, #fff, transparent),
                    radial-gradient(2rpx 2rpx at 80rpx 50rpx, #fff, transparent),
                    radial-gradient(3rpx 3rpx at 40rpx 140rpx, #93c5fd, transparent),
                    radial-gradient(2rpx 2rpx at 110rpx 180rpx, #fff, transparent);
}

.effect-preview-cyber {
  background: linear-gradient(to bottom, #09090b 60%, #1e1b4b 100%);
}

.preview-mini-cyber {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 50rpx;
  background: repeating-linear-gradient(0deg, transparent, transparent 8rpx, rgba(236,72,153,0.4) 8rpx, rgba(236,72,153,0.4) 10rpx),
              repeating-linear-gradient(90deg, transparent, transparent 14rpx, rgba(6,182,212,0.4) 14rpx, rgba(6,182,212,0.4) 16rpx);
}

.effect-preview-spotlight {
  background: #09090b;
}

.preview-mini-spotlight {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 200rpx;
  background: linear-gradient(to bottom, rgba(255,255,255,0.4), transparent);
  clip-path: polygon(40% 0%, 60% 0%, 100% 100%, 0% 100%);
}